### login  (POST /login)
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "emailId": "elonmusk@gmail.com",
    "password": "Abcd@1234!!!"
}

### Edit profile  (PATCH /profile/edit)
# Needs the login cookie, so send "login" first.
PATCH {{baseUrl}}/profile/edit
Content-Type: application/json

{
    "firstName": "elonn",
    "lastName": "musk",
    "about": "Updated about text",
    "age": 30,
    "skills": ["fiori", "cap", "node"]
}

### Send connection request  (POST /request/send/:status/:toUserId)
# Needs the login cookie, so send "login" first.
# status: interested or ignored
# toUserId: replace with the _id of another existing user
POST {{baseUrl}}/request/send/interested/PUT_TO_USER_ID_HERE

### Review connection request  (POST /request/review/:status/:requestId)
# Log in as the RECEIVER of the request (the user the request was sent to), not the sender.
# status: accepted or rejected
# requestId: replace with the _id of the connection request (returned as data._id by the send request)
POST {{baseUrl}}/request/review/accepted/PUT_REQUEST_ID_HERE

### Get received connection requests  (GET /user/requests)
# Needs the login cookie, so send "login" first.
# Returns the requests sent TO the logged in user that are still "interested".
GET {{baseUrl}}/user/requests/received

### Logout  (POST /logout)
POST {{baseUrl}}/logout

### Get user by email  (GET /user)
GET {{baseUrl}}/user
Content-Type: application/json

{
    "emailId": "bbsskrishna@gmail.com"
}

### Get all users - feed  (GET /feed)
GET {{baseUrl}}/feed

### Update user by id  (PATCH /user)
# Uses the _id returned by the "signup" request above.
PATCH {{baseUrl}}/user
Content-Type: application/json

{
    "id": "{{signup.response.body._id}}",
    "lastName": "Updated lastname",
    "age": 30,
    "gender": "male"
}

### Update user by id  (PATCH /user)
# Uses the _id returned by the "signup" request above.
#pass _id inside req params url (headers)
PATCH {{baseUrl}}/user/{{signup.response.body._id}}
Content-Type: application/json

{
    "about": "Updated about text",
    "age": 70,
    "gender": "male"
}

### Delete user by id  (DELETE /user)
# Uses the _id returned by the "signup" request above.
# Send "Signup" first in the same session, or replace with an existing _id.
DELETE {{baseUrl}}/user
Content-Type: application/json

{
    "id": "{{signup.response.body._id}}"
}
