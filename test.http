Content-Type: application/json

{
    "firstName": "elon",
    "lastName": "musk",
    "emailId": "elonmusk@gmail.com",
    "password": "Abcd@1234!!!",
    "skills":["fiori", "cap"],
    "age":26,
    "gender":"male"
}

